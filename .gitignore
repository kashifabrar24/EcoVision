# Virtual environments
venv/
.venv/
env/

# Data directory (Rule 8: Do not commit raw or processed datasets)
data/

# Environment variables and secrets
.env
.env.*

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# IDE configurations
.vscode/
.idea/

# OS-generated files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files and logs
*.log
*.tmp

# Hugging Face cache if stored locally
.cache/

# Intermediate seed checkpoints (keep baseline_cnn.pt, mobilenetv2_transfer.pt, mobilenetv2_final.pt tracked)
models/*_seed*.pt
